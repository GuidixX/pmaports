maintainer="Clayton Craft <clayton@craftyguy.net>"
pkgname=boot-deploy
pkgver=0.25.0
pkgrel=6
pkgdesc="tool for finalizing and deploying boot related files"
url="https://gitlab.postmarketos.org/postmarketOS/boot-deploy"
arch="noarch"
license="GPL-2.0-or-later"
source="
	https://gitlab.postmarketos.org/postmarketOS/boot-deploy/-/archive/$pkgver/boot-deploy-$pkgver.tar.gz

	os-customization
	0001-package-multiple-dtbs-in-vendor-boot.patch
	0002-deduplicate-initramfs-firmware.patch
	0003-respect-vendor-boot-load-addresses.patch
	0004-align-dtbs-in-vendor-boot.patch
	0005-package-multiple-dtbs-in-header2.patch
	test-vendor-boot-dtbs.py
	deduplicate-firmware.py
	pack-dtbs.py
	"
depends="generate-kernel-cmdline python3 zstd"
# needed for /usr/lib/os-release
checkdepends="postmarketos-release android-tools-mkbootimg python3"

check() {
	./test_boot_deploy_functions.sh
	python3 "$srcdir/test-vendor-boot-dtbs.py" "$builddir/boot-deploy-functions.sh"
}

package() {
	install -Dm755 boot-deploy "$pkgdir"/usr/bin/boot-deploy
	install -Dm755 boot-deploy-functions.sh \
		"$pkgdir"/usr/share/boot-deploy/boot-deploy-functions.sh
	install -Dm644 "$srcdir"/os-customization \
		"$pkgdir"/usr/share/boot-deploy/os-customization
	install -Dm755 "$srcdir"/deduplicate-firmware.py \
		"$pkgdir"/usr/libexec/boot-deploy/deduplicate-firmware.py
	install -Dm755 "$srcdir"/pack-dtbs.py \
		"$pkgdir"/usr/libexec/boot-deploy/pack-dtbs.py

	touch boot-deploy-trigger
	install -Dm644 boot-deploy-trigger \
		"$pkgdir"/usr/share/mkinitfs-triggers/boot-deploy
}
