maintainer="Oliver Smith <ollieparanoid@postmarketos.org>"
pkgname=postmarketos-android-recovery-installer
pkgver=1.0.7
pkgrel=2
pkgdesc="TWRP compatible postmarketOS installer script"
arch="all"
url="https://postmarketos.org"
license="GPL-3.0-or-later"
# multipath-tools: kpartx
depends="busybox-extras lddtree cryptsetup multipath-tools device-mapper parted util-linux zip e2fsprogs tar python3"
source="
	https://gitlab.com/postmarketos/postmarketos-android-recovery-installer/-/archive/$pkgver/postmarketos-android-recovery-installer-$pkgver.tar.gz
	build_zip.sh
	pmos_chroot
	pmos_install
	pmos_install_functions
	pmos_boot_images
	generate_boot_options.py
"
options="!check" # No tests

prepare() {
	default_prepare
	for file in build_zip.sh pmos_chroot pmos_install pmos_install_functions; do
		cp "$srcdir/$file" "$builddir/$file"
	done
}

build() {
	gcc -static -o disable-warning disable-warning.c
}

package() {
	install -Dm755 build_zip.sh \
		"$pkgdir"/usr/bin/build-recovery-zip
	install -Dm644 update-binary \
		"$pkgdir"/var/lib/postmarketos-android-recovery-installer/META-INF/com/google/android/update-binary
	install -Dm755 pmos_chroot \
		"$pkgdir"/var/lib/postmarketos-android-recovery-installer/pmos_chroot
	install -Dm755 disable-warning \
		"$pkgdir"/var/lib/postmarketos-android-recovery-installer/disable-warning
	for file in pmos_install pmos_install_functions pmos_setpw pmos_install_part; do
		install -Dm755 $file \
			"$pkgdir"/var/lib/postmarketos-android-recovery-installer/chroot/bin/$file
	done
	install -Dm755 "$srcdir/pmos_boot_images" \
		"$pkgdir"/var/lib/postmarketos-android-recovery-installer/chroot/bin/pmos_boot_images
	install -Dm755 "$srcdir/generate_boot_options.py" \
		"$pkgdir"/usr/libexec/postmarketos-android-recovery-installer/generate_boot_options.py
}
