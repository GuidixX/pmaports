8cc4c71f8985720f7017d5a27dbfee75cc82f3f24cf18e9e9b458ea0797585b6cb3237735b917a4c8e06de4b309f9bc01ba77f291e90f77fdb3ea3587daa4cb5  embed-firmware.py
"
