maintainer="Guidix <guidixm@gmail.com>"
pkgname=linux-postmarketos-qcom-sm6225
pkgver=7.4.0_rc3
pkgrel=6
pkgdesc="Nura mainline kernel for Xiaomi spes and spesn"
arch="aarch64"
url="https://github.com/GuidixX/kernel_xiaomi_sm6225-mainline"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="bc bison clang diffutils elfutils-dev findutils flex kmod linux-headers lld llvm openssl-dev pahole perl postmarketos-installkernel python3 zstd"
_carch="arm64"
_flavor="postmarketos-qcom-sm6225"
_config="config-$_flavor.$arch"
source="$_config
	embed-firmware.py
	"
builddir="$srcdir/linux"

prepare() {
	[ -f "$builddir/Makefile" ] || {
		echo "Use nura/build.sh to build this package with the local kernel source." >&2
		return 1
	}
	default_prepare
	cp "$srcdir/$_config" "$builddir/.config"
	make ARCH="$_carch" LLVM=1 olddefconfig
	python3 "$srcdir/embed-firmware.py" prepare "$builddir"
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		Image.gz modules \
		qcom/sm6225-xiaomi-spes-sm5602.dtb qcom/sm6225-xiaomi-spesn.dtb
	python3 "$srcdir/embed-firmware.py" verify "$builddir"
	# Keep space for the v3 header in the 128 MiB boot partition.
	[ "$(stat -c %s arch/arm64/boot/Image.gz)" -le 134213632 ] || {
		echo "Kernel with embedded firmware exceeds the boot partition." >&2
		return 1
	}
}

package() {
	make ARCH="$_carch" LLVM=1 modules_install \
		INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1
	install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/vmlinuz"
	for _dtb in sm6225-xiaomi-spes-sm5602 sm6225-xiaomi-spesn; do
		install -Dm644 "arch/arm64/boot/dts/qcom/$_dtb.dtb" \
			"$pkgdir/boot/dtbs/qcom/$_dtb.dtb"
	done
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
	install -Dm644 include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	install -Dm644 nura-firmware/manifest.json \
		"$pkgdir/usr/share/kernel/$_flavor/firmware-manifest.json"
}

