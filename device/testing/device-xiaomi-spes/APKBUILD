	android-tools-mkbootimg
	android-tools-mkdtboimg
	firmware-xiaomi-spes
	linux-postmarketos-qcom-sm6225
	make-dynpart-mappings
        mesa-vulkan-freedreno
	mkbootimg
	msm-modem
        postmarketos-base
        qbootctl
        swclock-offset
        tqftpserv
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
"
subpackages="
	$pkgname-kernel-spes-sm5602:kernel_spes_sm5602
	$pkgname-kernel-spes-max77729:kernel_spes_max77729
	$pkgname-kernel-spesn:kernel_spesn
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

kernel_spes_sm5602() {
	pkgdesc="Xiaomi Redmi Note 11 (spes) with SM5602 PMIC"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

kernel_spes_max77729() {
	pkgdesc="Xiaomi Redmi Note 11 (spes) with Maxim MAX77729 PMIC"
	echo "WARNING: There is currently no support for $pkgdesc."
	exit 0
}

kernel_spesn() {
	pkgdesc="Xiaomi Redmi Note 11 NFC (spesn)"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

