# Reference: <https://postmarketos.org/devicepkg>
maintainer="Guidix <guidixm@gmail.com>"
pkgname=device-xiaomi-spes
pkgdesc="Xiaomi Redmi Note 11"
pkgver=4
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools-fastboot
	android-tools-mkbootimg
	android-tools-mkdtboimg
	firmware-xiaomi-spes
	linux-postmarketos-qcom-sm6225
	make-dynpart-mappings
        mesa-vulkan-freedreno
	msm-modem
        postmarketos-base
	postmarketos-zram
        qbootctl
        swclock-offset
        tqftpserv
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	initfs-hook.sh
	kernel-cmdline.conf
	nura-device-variant
	nura-device-variant.files
	nura-device-variant.service
	nura-zram-start
	nura-zram.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/nura-device-variant" "$pkgdir/usr/libexec/nura-device-variant"
	install -Dm644 "$srcdir/nura-device-variant.files" \
		"$pkgdir/usr/share/mkinitfs/files/00-$pkgname-variant.files"
	install -Dm644 "$srcdir/nura-device-variant.service" \
		"$pkgdir/usr/lib/systemd/system/nura-device-variant.service"
	mkdir -p "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
	ln -s ../nura-device-variant.service \
		"$pkgdir/usr/lib/systemd/system/sysinit.target.wants/nura-device-variant.service"
	install -Dm755 "$srcdir/nura-zram-start" "$pkgdir/usr/libexec/nura-zram-start"
	install -Dm644 "$srcdir/nura-zram.conf" \
		"$pkgdir/usr/lib/systemd/system/postmarketos-zram-swap.service.d/50-nura.conf"
	mkdir -p "$pkgdir/usr/lib/systemd/system/swap.target.wants"
	ln -s ../postmarketos-zram-swap.service \
		"$pkgdir/usr/lib/systemd/system/swap.target.wants/postmarketos-zram-swap.service"
}


