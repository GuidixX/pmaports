maintainer="Guidix <guidixm@gmail.com>"
pkgname=firmware-xiaomi-spes
pkgver=1
pkgrel=1
pkgdesc="Firmware for Xiaomi spes and spesn"
url="https://github.com/GuidixX/firmware-xiaomi-spes"
arch="aarch64"
license="proprietary"
options="!strip !check !archcheck !tracedeps textrels pmb:cross-native"
depends="linux-firmware-ath10k linux-firmware-qca firmware-qcom-adreno-a630"
source="30-initramfs-firmware.files"
builddir="$srcdir/firmware"

prepare() {
	[ -d "$builddir/qcom/sm6225/XIAOMI/SPESN" ] || {
		echo "Use nura/build.sh to build this package with the local firmware source." >&2
		return 1
	}
}

package() {
	for _variant in SPES SPESN; do
		install -Dm644 qcom/sm6225/XIAOMI/$_variant/* \
			-t "$pkgdir/usr/lib/firmware/qcom/sm6225/XIAOMI/$_variant/"
	done
	install -Dm644 "$srcdir/30-initramfs-firmware.files" \
		"$pkgdir/usr/share/mkinitfs/files/30-initramfs-firmware.files"
}

# prepare.py adds the checksum of the verified firmware list.
sha512sums="
54c65480606a0642117e948fd132c525d1a6d9d046ce59ccc03aa0e8b3ed01a6ca67691aa6a288fa76f75fe50a08dd0646dc7c71916be3839cc9d1e5a193d4bb  30-initramfs-firmware.files
"
