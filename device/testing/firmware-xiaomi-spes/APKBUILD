maintainer="Oscar Allegro <hsc100zz@gmail.com>"
pkgname=firmware-xiaomi-spes
pkgver=1
pkgrel=0
pkgdesc="Firmware for spes"
url="https://gitlab.postmarketos.org/sm6225-mainline/firmwares/firmware-xiaomi-spes"
arch="aarch64"
license="proprietary"
options="!strip !check !archcheck !tracedeps textrels pmb:cross-native"

_commit="817df49d5b4f4b9db629b0b04e5bf85c80ec20e3"

source="
	$pkgname.tar.gz::$url/-/archive/$_commit/$pkgname-$_commit.tar.gz
	30-initramfs-firmware.files
"
builddir="$srcdir/$pkgname-$_commit"

package() {
	echo $builddir
	_fw_path=$pkgdir/usr/lib/firmware

	install -Dm644 qcom/sm6225/XIAOMI/SPES/* -t "$_fw_path"/qcom/sm6225/XIAOMI/SPES/

	install -Dm644 "$srcdir/30-initramfs-firmware.files" -t "$pkgdir"/usr/share/mkinitfs/files

	ln -s "$_fw_path"/qcom/sm6225/SPES/ "$_fw_path"/qcom/sm6225/SPESN/
}

